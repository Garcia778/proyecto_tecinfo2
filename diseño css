body {
    background-color: #d3d3d3; /* gris claro */
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

.marquesina {
    background-color: #333;
    color: white;
    padding: 10px;
    font-weight: bold;
}

.menu ul {
    list-style-type: none;
    background-color: #444;
    padding: 10px;
    margin: 0;
    display: flex;
    justify-content: space-around;
}

.menu ul li a {
    color: white;
    text-decoration: none;
    padding: 10px 20px;
    display: block;
}

.menu ul li a:hover {
    background-color: #666;
}

.portada {
    text-align: center;
    padding: 30px;
}

.imagen-portada {
    max-width: 300px;
    margin-top: 20px;
    border: 2px solid #555;
    border-radius: 10px;
}

#btnInteraccion {
    margin-top: 20px;
    padding: 10px 20px;
    font-size: 16px;
    cursor: pointer;
}

#btnInteraccion:hover {
    background-color: #007BFF;
    color: white;
}
